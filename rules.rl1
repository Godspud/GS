// PROGRAM

program
	: stmt_list
	;

stmt_list
	: /* empty */
	| stmt_list stmt
	;

stmt
	: simple_stmt
	| compound_stmt
	;

// SIMPLE STATEMENTS

simple_stmt
	: variable_decl EOL
	| assignment_expr EOL
	| expression EOL
	| RETURN EOL
	| RETURN expression EOL
	| BREAK EOL
	| CONTINUE EOL
	| PASS EOL
	| raise_stmt EOL
	| assert_stmt EOL
	| del_stmt EOL
	| include_stmt EOL
	;

// BLOCKS / COMPOUND STATEMENTS

block
	: LCRBPAREN stmt_list RCRBPAREN
	;

compound_stmt
	: if_stmt
	| while_stmt
	| for_stmt
	| try_stmt
	| with_stmt
	| match_stmt
	| function_def
	| class_def
	;

// TYPES / VARIABLES

type
	: TYPE
	| IDENT
	;

variable_decl
	: type IDENT
	| type IDENT ASSIGN expression
	| CONST IDENT ASSIGN expression
	;

// FUNCTIONS

function_def
	: DEF return_type_opt IDENT parameter_list block
	;

return_type_opt
	: /* empty */
	| TYPE
	;

parameter_list
	: LNORPAREN RNORPAREN
	| LNORPAREN parameter_seq RNORPAREN
	;

parameter_seq
	: parameter
	| parameter_seq COMMA parameter
	;

parameter
	: type_opt IDENT
	| type_opt IDENT ASSIGN expression
	| ASTERISK IDENT
	| ASTERISK ASTERISK IDENT
	| type ASTERISK IDENT
	| type ASTERISK ASTERISK IDENT
	;

type_opt
	: /* empty */
	| type
	;

// CLASSES

class_def
	: CLASS IDENT class_block
	| CLASS LNORPAREN IDENT RNORPAREN IDENT class_block
	;

class_block
	: LCRBPAREN class_member_list RCRBPAREN
	;

class_member_list
	: /* empty */
	| class_member_list class_member
	;

class_member
	: variable_decl EOL
	| function_def
	| AT IDENT EOL function_def
	;

// INCLUDE

include_stmt
	: INCLUDE STR
	| INCLUDE import_list FROM STR
	| INCLUDE import_list FROM STR AS alias_list
	;

import_list
	: IDENT
	| import_list COMMA IDENT
	;

alias_list
	: IDENT
	| alias_list COMMA IDENT
	;

// IF / ELIF / ELSE

if_stmt
	: IF LNORPAREN expression RNORPAREN block elif_list else_opt
	;

elif_list
	: /* empty */
	| elif_list ELIF LNORPAREN expression RNORPAREN block
	;

else_opt
	: /* empty */
	| ELSE block
	;

// LOOPS

while_stmt
	: WHILE LNORPAREN expression RNORPAREN block
	;

for_stmt
	: FOR LNORPAREN IDENT IN expression RNORPAREN block
	;

// TRY / EXCEPT / FINALLY

try_stmt
	: TRY block except_list finally_opt
	;

except_list
	: EXCEPT block
	| EXCEPT IDENT block
	| except_list EXCEPT block
	| except_list EXCEPT IDENT block
	;

finally_opt
	: /* empty */
	| FINALLY block
	;

// WITH

with_stmt
	: WITH expression block
	| WITH expression AS IDENT block
	;

// MATCH / CASE

match_stmt
	: MATCH LNORPAREN expression RNORPAREN
	  LCRBPAREN case_list RCRBPAREN
	;

case_list
	: /* empty */
	| case_list CASE case_pattern block
	| case_list DEFAULT block
	;

case_pattern
	: expression
	| case_pattern COMMA expression
	;

// EXCEPTIONS / ASSERT / DEL

raise_stmt
	: RAISE expression
	;

assert_stmt
	: ASSERT expression
	| ASSERT expression COMMA expression
	;

del_stmt
	: DEL lvalue
	;

// EXPRESSIONS

expression
	: assignment_expr
	;

assignment_expr
	: conditional_expr
	| lvalue assignment_operator assignment_expr
	| lvalue COLON ASSIGN assignment_expr
	;

assignment_operator
	: ASSIGN
	| PLUS ASSIGN
	| MINUS ASSIGN
	| ASTERISK ASSIGN
	| DIVIDE ASSIGN
	| MOD ASSIGN
	;

// CONDITIONAL / LOGICAL

conditional_expr
	: logical_or_expr
	| logical_or_expr QUESTION expression COLON conditional_expr
	;

logical_or_expr
	: logical_and_expr
	| logical_or_expr OR logical_and_expr
	;

logical_and_expr
	: equality_expr
	| logical_and_expr AND equality_expr
	;

equality_expr
	: comparison_expr
	| equality_expr EQ comparison_expr
	| equality_expr NE comparison_expr
	| equality_expr IS comparison_expr
	;

comparison_expr
	: additive_expr
	| comparison_expr LT additive_expr
	| comparison_expr GT additive_expr
	| comparison_expr LE additive_expr
	| comparison_expr GE additive_expr
	| comparison_expr IN additive_expr
	;

// ARITHMETIC

additive_expr
	: multiplicative_expr
	| additive_expr PLUS multiplicative_expr
	| additive_expr MINUS multiplicative_expr
	;

multiplicative_expr
	: unary_expr
	| multiplicative_expr ASTERISK unary_expr
	| multiplicative_expr DIVIDE unary_expr
	| multiplicative_expr MOD unary_expr
	;

unary_expr
	: postfix_expr
	| MINUS unary_expr
	| PLUS unary_expr
	| NOT unary_expr
	| ASTERISK unary_expr
	| AMPERSAND unary_expr
	;

// POSTFIX EXPRESSIONS

postfix_expr
	: primary_expr
	| postfix_expr call_suffix
	| postfix_expr member_suffix
	| postfix_expr index_suffix
	;

call_suffix
	: LNORPAREN RNORPAREN
	| LNORPAREN argument_list RNORPAREN
	;

member_suffix
	: DOT IDENT
	;

index_suffix
	: LSQRPAREN index_or_slice RSQRPAREN
	;

// INDEXING / SLICING

index_or_slice
	: expression
	| slice_expr
	;

slice_expr
	: slice_start_opt COLON slice_stop_opt
	| slice_start_opt COLON slice_stop_opt COLON slice_step_opt
	;

slice_start_opt
	: /* empty */
	| expression
	;

slice_stop_opt
	: /* empty */
	| expression
	;

slice_step_opt
	: /* empty */
	| expression
	;

lvalue
	: postfix_expr
	;

// FUNCTION ARGUMENTS

argument_list
	: argument
	| argument_list COMMA argument
	;

argument
	: expression
	| IDENT ASSIGN expression
	| ASTERISK expression
	| ASTERISK ASTERISK expression
	;

// PRIMARY EXPRESSIONS

primary_expr
	: literal
	| IDENT
	| tuple_expr
	| list_expr
	| dict_expr
	| set_expr
	| parenthesized_expr
	| cast_expr
	| fstring_expr
	;

literal
	: INT
	| FLOAT
	| STR
	| BOOL
	| NONE
	;

parenthesized_expr
	: LNORPAREN expression RNORPAREN
	;

cast_expr
	: LNORPAREN type RNORPAREN unary_expr
	;

// LISTS

list_expr
	: LSQRPAREN RSQRPAREN
	| LSQRPAREN expression_list RSQRPAREN
	;

expression_list
	: expression
	| expression_list COMMA expression
	;

// DICTIONARIES

dict_expr
	: LCRBPAREN RCRBPAREN
	| LCRBPAREN dict_items RCRBPAREN
	;

dict_items
	: dict_item
	| dict_items COMMA dict_item
	;

dict_item
	: expression COLON expression
	;

// SETS

set_expr
	: LCRBPAREN set_items RCRBPAREN
	;

set_items
	: expression
	| set_items COMMA expression
	;

// TUPLES

tuple_expr
	: LNORPAREN RNORPAREN
	| LNORPAREN expression COMMA RNORPAREN
	| LNORPAREN expression COMMA expression tuple_tail RNORPAREN
	;

tuple_tail
	: /* empty */
	| COMMA
	| COMMA expression tuple_tail
	;

// F-STRINGS

//
// The current lexer does not expose FSTRING as a token.
// The examples use f"...", so this represents the current
// lexer behaviour as IDENT STR until dedicated f-string
// lexing is added.
//

fstring_expr
	: IDENT STR
	;