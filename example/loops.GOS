int main()
{
    // while loop
    x = 1;
    y = "x";
    while (x) // implied truth any non 0 is true like c
    {
        if (x == 1 && y == "y")
        {
            x = False;
        }
        y = (str)input();
    }

    // for loop
    strs = ["hi", "me 2nd index!", "HIYAHHHH"]
    for (str str in strs)
    {
        print(x);
    }
}