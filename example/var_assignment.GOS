int main()
{
    x = 5; // will auto assign to int it is optional to add the type this is of type any
    // then u can reassign with
    x = 'hi';
    // but if u do 
    int x = 5;
    // then u cannot do
    x = 'hi';
    // or
    char x[2] = 'hi';
    //or
    str x = 'hi';
    // cos it is now ALWAYS forced to be a int

    // then
    x = 5
    x = 3.14 
    // allawed cos any type can be reassigned to any other type

    x = 5
    y = x + 1 
    // y is a int as int + int is int

    x = 5
    x = "hi"
    z = x + 1 
    // error cos str cannot add with a int

    // type casting
    (typename)varname
    // so like using both syntaxs
    x = 5;
    x = (str)x;
    // or 
    x = (char)x;

    // then
    int x = 5;
    x = (str)x;
    // or
    y = (char)x; // NOTE: WILL NOT ERROR COS ASSIGN TO SOMEONE else
    x = (char)x; // ERROR CANNOT assign
}