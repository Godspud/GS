// #include Name from "file" pulls in just one class or function,
// not the whole file. Optionally rename it with 'as'.
//
// Note: extracting a single class only pulls that class's own
// definition, not anything it depends on (e.g. a parent class) --
// if 'Greeter' inherited from another class, that parent would also
// need its own #include.

#include square from "15_include_lib.gs"
#include Greeter from "15_include_lib.gs" as Welcomer

print(f"square(6) = {square(6)}");
// note: cube() was never included, so it isn't available here at all

Welcomer w = Welcomer();
w.name = "there";
print(w.greeting());
